	File = {:Volumes/Data/Users/cshih/Documents/Mendeley/Lin et al/IEEE GreenCom-iThings-CPSCom 2013/Lin et al. - 2013 - Building Smart M2M Applications Using the WuKong Profile Framework.pdf:pdf},
	Isbn = {9780769550466},
	Keywords = {wireless sensor networks,chi-sheng shih,configuration,machine-to-machine,middleware,neils reijers,profile,virtual machine,wireless sensor networks,yu-chung wang},
	Pages = {1175 -- 1180},
