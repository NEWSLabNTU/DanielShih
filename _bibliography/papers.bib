@inproceedings{Shih2013,
	Abstract = {How to exchange information between parties in a disaster management system is one of the fundamental challenges to support timely and efficient disaster response and relief. Specifically, the timeliness, scalability, and availability are three desirable features for information exchange. We call the framework to support information exchange with the three features an Open Information Gateway (OIGY). In this paper, we present the challenges of information gateway and the design of the communication protocols and landmark-based service recovery mechanism to support the aforementioned features. The mechanism aims at recovering the real-time publish and subscription services within an affected region. The developed method allows a landmark service node to monitor pub/sub service within a region, rather than the entire pub/sub network. To evaluate the performance of the service-recover mechanism, we measured its transmission and recovery overhead under different number of message brokers in the network.},
	Address = {A Coru\~{n}a, Spain},
	Author = {Shih, Chi-Sheng and Chen, Hsin-Yi and Chen, L.J.},
	Booktitle = {Disaster Management},
	Doi = {10.2495/DMAN130191},
	Editor = {{C A Brebbia}},
	File = {:Volumes/Data/Users/cshih/Documents/Mendeley/Shih, Chen, Chen/Disaster Management 2013/Shih, Chen, Chen - 2013 - Landmark-based Self-Healing Service Recovery for Distributed Pub Sub Services on Disaster Management and M2M.pdf:pdf},
	Keywords = {NSC\_CPSProjectResults,message publish and subscription,middleware,service recovery},
	Mendeley-Tags = {NSC\_CPSProjectResults},
	Publisher = {Wessex Institute of Technology},
	Title = {{Landmark-based Self-Healing Service Recovery for Distributed Pub / Sub Services on Disaster Management and M2M Systems}},
	Url = {http://library.witpress.com/pages/PaperInfo.asp?PaperID=25032},
	Year = {2013},
	Bdsk-Url-1 = {http://library.witpress.com/pages/PaperInfo.asp?PaperID=25032},
	Bdsk-Url-2 = {http://dx.doi.org/10.2495/DMAN130191}}

@inproceedings{Reijers2013,
	Abstract = {Most current sensor network applications are built for fixed sensor platforms with a specific wireless network support, building on top of a lightweight OS or even directly on the hardware, and writing applications in an imperative way and from each local node's perspective. This results in software that supports only a specific set of sensors, and difficult to be ported to other platforms. Such software is not acceptable in machine-to-machine (M2M) systems where applications must run on platforms that are inter- operatable and may evolve with time. In this paper we present a project on building intelligent middleware for M2M. The middleware is designed to perform automatic sensor identification, node configuration, application upgrade, and system re-configuration. It allows system developers to specify the application behavior at a higher level, instead of telling each sensor node what to do. A prototype design is presented, as well as the status of our current implementation.},
	Address = {Barcelona, Spain},
	Author = {Reijers, Neils and Lin, KJ and Wang, YC and Shih, Chi-Sheng and Hsu, JY},
	Booktitle = {2nd International Conference on Sensor Networks (2013 Sensornets)},
	Date-Modified = {2018-06-05 01:51:06 +0000},
	File = {:Volumes/Data/Users/cshih/Documents/Mendeley/Reijers et al/2013 2nd International Conference on Sensor Networks (2013 Sensornets)/Reijers et al. - 2013 - Design of An Intelligent Middleware for Flexible Sensor Configuration in M2M Systems.pdf:pdf},
	Month = {February},
	Pages = {13--22},
	Title = {{Design of An Intelligent Middleware for Flexible Sensor Configuration in M2M Systems}},
	Url = {http://www.agent.csie.ntu.edu.tw/system/papers/227/original/wukong-sensornets2013-cameraready-v2.pdf},
	Year = {2013},
