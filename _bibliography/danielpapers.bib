@article{Huang2018,
title = {Building edge intelligence for online activity recognition in service-oriented IoT systems},
journal = {Future Generation Computer Systems},
volume = {},
number = {},
pages = { - },
year = {2018},
note = {},
issn = {0167-739X},
doi = {https://doi.org/10.1016/j.future.2018.03.003},
url = {https://www.sciencedirect.com/science/article/pii/S0167739X17306520},
author = {Huang, Zhenqiu and Lin, Kwei-Jay and Tsai, Bo-Lung and Yan, Surong and Shih, Chi-Sheng},
abstract = {This paper presents the edge intelligence support for smart Internet of Things (IoT) using the service-oriented architecture. In IoT systems, real-time sensor data collected from users and environments should be integrated for activity analysis to enhance the system intelligence. In this paper, we propose an edge intelligence framework for building WuKong-based IoT applications. WuKong is a service-oriented IoT middleware that supports easy composition and dynamic deployment of user-defined IoT service workflows. The proposed edge intelligence framework pushes the streaming processing capability from cloud core to edge devices, in order to better support timely and reliable streaming data analytics in smart IoT applications. We have designed annotation based programming primitives for developers to build online learning capabilities on edge devices. We have also implemented a user activity recognition engine, and compared its performances between running on either an edge device or cloud servers. We find that using the edge intelligence framework can improve the real-time and fault-tolerance performance significantly without degrading the user activity recognition accuracy in a smart home environment.}
}

